### FNF-Specific
# File used for the NG API. Should not be shared with others.
APIStuff.hx
art/buildScripts/build_x32-officialrelease.bat
art/buildScripts/build_x64-officialrelease.bat
art/buildScripts/test_x64-debug-officialrelease.bat

### VS Code
export/*
.vscode/*
.haxelib/
.github/
*.code-workspace
vs_Community.exe
# Local history which shouldn't be shared.
.history
.ionide
# macOS file attribute which can cause problems when uploading.
*.DS_Store
# ! means a file should be added regardless of it it gets ignored prior.
# Including to allow others to use already set-up configuration tweaked for the project.
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
art/build_html.bat
art/build_html-debug.bat

# Android release signing (keep private). Key lives outside the repo at
# Q:/Android/signing/; signing.local.xml holds the <certificate> referencing it.
release.keystore
signing.local.xml

# TEMP ignore
art/example-osu-skins/*

# DOOM game data. The scripted DOOM port ships no IWAD; these are local dev copies
# of user-supplied data and must never be committed.
*.wad
*.WAD
\[Scripted Games\]/\[Scripted Game\] Doom/DOOM/
\[Scripted Games\]/\[Scripted Game\] Doom/wadext.exe

# Written by the build under `-D scriptable`: the list of classes exposed to loaded bytecode.
# Regenerated every time, so it only ever shows up as noise in a diff.
export_classes.info
