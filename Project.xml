<?xml version="1.0" encoding="utf-8"?>
<project>

	<!-- ============================== Application ============================== -->

	<app title="Friday Night Funkin': Psych Engine" file="PsychEngine" packageName="com.lulu.psychengine" package="com.lulu.psychengine" main="Main" version="0.2.8" company="Lulu" />
	<app preloader="flixel.system.FlxPreloader" />

	<set name="APP_ID" value="0x0100f6c013bbc000" /> <!-- Switch export: unique application ID -->
	<set name="SWF_VERSION" value="11.8" />          <!-- Min 11.8 with gamepad, 11.2 with native cursor -->

	<!-- ============================= Feature Flags ============================= -->

	<!-- Scripting & mods -->
	<define name="MODS_ALLOWED"    if="desktop || mobile" />
	<define name="HSCRIPT_ALLOWED" if="desktop || mobile" />
	<define name="LUA_ALLOWED"     if="desktop || mobile" />

	<!-- Core features -->
	<define name="ACHIEVEMENTS_ALLOWED" />
	<define name="TRANSLATIONS_ALLOWED" />
	<define name="BASE_GAME_FILES" />
	<define name="TITLE_SCREEN_EASTER_EGG" />
	<define name="CHECK_FOR_UPDATES" if="desktop" />
	<define name="DISCORD_ALLOWED"   if="desktop" /> <!-- Discord RPC is desktop-only IPC; hxdiscord_rpc has no android/mobile backend -->
	<define name="VIDEOS_ALLOWED"    if="desktop || mobile" />
	<define name="CRASH_HANDLER"     if="desktop || mobile" />
	<define name="IRIS_DEBUG" />

	<!-- Loading screen -->
	<define name="MULTITHREADED_LOADING" />
	<define name="SHOW_LOADING_SCREEN" />
	<define name="PSYCH_WATERMARKS" /> <!-- DELETE THIS TO REMOVE THE PSYCH LOGO FROM LOADING SCREEN -->

	<!-- Optional desktop-only features -->
	<define name="CONVERTERS_ALLOWED" if="desktop" /> <!-- Chart converters for other games -->
	<define name="HARDWARE_ALLOWED"   if="desktop" /> <!-- CPU/GPU FPS readouts; needs the hxhardware haxelib (see Libraries) -->

	<!-- =============================== Window ================================== -->

	<window width="1280" height="720" fps="60" background="#000000" hardware="true" vsync="false" allow-high-dpi="true" /> <!-- all targets -->
	<window if="html5"   resizable="true" />
	<window if="desktop" orientation="landscape" fullscreen="false" resizable="true"  vsync="false" />
	<window if="mobile"  orientation="landscape" fullscreen="true"  resizable="false" width="0" height="0" />
	<window if="switch"  orientation="landscape" fullscreen="true"  resizable="true"  width="0" height="0" />

	<!-- ================================ Paths ================================== -->

	<set name="BUILD_DIR" value="export/debug"   if="debug" />
	<set name="BUILD_DIR" value="export/release" unless="debug" />
	<classpath name="source" />

	<!-- ================================ Assets ================================= -->

	<assets path="assets/fonts" />
	<assets path="assets/shared"        exclude="*.ogg" if="web"/>
	<assets path="assets/shared"        exclude="*.mp3" unless="web"/>
	<assets path="assets/embed"         exclude="*.ogg" if="web" embed="true"/>
	<assets path="assets/embed"         exclude="*.mp3" unless="web" embed="true"/>
	<assets path="assets/videos"        if="VIDEOS_ALLOWED"/>
	<assets path="assets/songs"         exclude="*.ogg" if="web"/>
	<assets path="assets/songs"         exclude="*.mp3" unless="web"/>
	<assets path="assets/week_assets"   rename="assets" exclude="*.ogg" if="web"/>
	<assets path="assets/week_assets"   rename="assets" exclude="*.mp3" unless="web"/>

	<section if="TITLE_SCREEN_EASTER_EGG">
		<assets path="assets/secrets" rename="assets/shared" exclude="*.ogg" if="web"/>
		<assets path="assets/secrets" rename="assets/shared" exclude="*.mp3"  unless="web"/>
	</section>

	<section if="TRANSLATIONS_ALLOWED">
		<assets path="assets/translations" rename="assets" exclude="*.ogg" if="web"/>
		<assets path="assets/translations" rename="assets" exclude="*.mp3"  unless="web"/>
	</section>

	<section if="BASE_GAME_FILES">
		<assets path="assets/base_game" rename="assets" exclude="*.ogg" if="web"/>
		<assets path="assets/base_game" rename="assets" exclude="*.mp3"  unless="web"/>
		<haxelib name="grig.audio" if="BASE_GAME_FILES"/>
		<haxelib name="funkin.vis" if="BASE_GAME_FILES"/>
	</section>

	<section if="MODS_ALLOWED">
		<assets path='example_mods' rename='mods' embed='false' type='template' unless="mac || mobile"/>
		<assets path='example_mods' rename='mods' embed='false' if="mac"/>
		<!-- Mobile: the template copy above only reaches the build dir, never the device.
		     Ship the examples inside the APK instead; StorageUtil.installBundledExamples
		     copies them into the public mods/ folder on boot (per-file, idempotent). -->
		<assets path='example_mods' rename='example_mods' if="mobile"/>
		<assets path='list.txt' rename='modsList.txt' />
	</section>

	<assets path='art/readme.txt' rename='do NOT readme.txt' />

	<!-- OpenAL config -->
	<section if="desktop">
		<assets path="alsoft.txt" rename="plugins/alsoft.ini" type="text" if="windows"/>
		<assets path="alsoft.txt" rename="plugins/alsoft.conf" type="text" unless="windows"/>
	</section>

	<!-- =============================== Android ================================= -->

	<section if="android">
		<!-- Public top-level storage (/storage/emulated/0/PsychEngine) so mods/saves
		     are browsable in any file manager. Needs All Files Access on Android 11+. -->
		<config:android permission="android.permission.INTERNET" />
		<config:android permission="android.permission.ACCESS_NETWORK_STATE" />
		<config:android permission="android.permission.READ_EXTERNAL_STORAGE" />
		<config:android permission="android.permission.WRITE_EXTERNAL_STORAGE" />
		<config:android permission="android.permission.MANAGE_EXTERNAL_STORAGE" />
		<config:android permission="android.permission.READ_MEDIA_IMAGES" />
		<config:android permission="android.permission.READ_MEDIA_VIDEO" />
		<config:android permission="android.permission.READ_MEDIA_AUDIO" />
		<config:android permission="android.permission.VIBRATE" />
		<config:android permission="android.permission.REQUEST_INSTALL_PACKAGES" /> <!-- self-update: hand a downloaded APK to the system installer -->
		<config:android target-sdk-version="34" />
		<config:android minimum-sdk-version="21" />
		<!-- Render into the display cutout on notched phones instead of letterboxing;
		     lime's GameActivity applies this via layoutInDisplayCutoutMode on API 28+. -->
		<config:android layoutInDisplayCutoutMode="shortEdges" />

		<include path="signing.local.xml" unless="debug" /> <!-- REMOVE THIS if you don't use signing keys -->

		<architecture exclude="armv7" />
		<architecture exclude="armv7s" />
		<architecture exclude="x86" />
		<!-- Shipping builds are arm64-only. Android Studio AVDs on an x86 host are x86_64,
		     so "lime build android -Demulator" swaps the arm64 slice for x86_64 instead. -->
		<architecture exclude="x64" unless="emulator" />
		<architecture name="x64" if="emulator" />
		<architecture exclude="arm64" if="emulator" />

		<!-- Legacy square icons (drawable-*dpi/icon.png) are auto-generated by lime from
		     the <icon> tags below. This template overlay adds the API 26+ adaptive icon
		     (drawable-anydpi-v26/icon.xml + mipmap-*dpi/icon_foreground.png) so launchers
		     mask it into circle/squircle/rounded-square shapes. Android resolves the same
		     "@drawable/icon" name to the adaptive xml on 26+ and the raster on older. -->
		<template path="art/icons/templates" />

		<!-- Game Mode API (Android 12+) opt-in: overrides lime's AndroidManifest to add
		     the android.game_mode_config meta-data + ships res/xml/game_mode_config.xml.
		     Battery/Performance modes are self-handled (mobile.backend.GameModeUtil);
		     system downscaling and FPS override are refused. The manifest MUST be the
		     explicit file+rename form: file templates are copied after the directory
		     overlays, which lose collisions against lime's own templates. NOTE: the
		     manifest copy tracks lime 8.3.2's template re-diff it if lime is updated. -->
		<template path="art/android/templates" />
		<template path="art/android/AndroidManifest.xml" rename="app/src/main/AndroidManifest.xml" />

		<!-- Activity-level Back interception: SDL's key path drops system-injected key
		     events on some builds, so MainActivity consumes KEYCODE_BACK itself and
		     mobile.backend.BackButton polls the counter. Same file+rename rule as the
		     manifest above; the rename path must track the app package. -->
		<template path="art/android/MainActivity.java" rename="app/src/main/java/com/lulu/psychengine/MainActivity.java" />
		<!-- Raises the Gradle daemon heap: the stock template's default OOMs packaging our ~350MB APK. -->
		<template path="art/android/gradle.properties" rename="gradle.properties" />
	</section>

	<!-- ============================== Libraries =============================== -->

	<haxelib name="flixel"/>
	<haxelib name="flixel-addons"/>
	<haxelib name="flixel-animate"/>
	<haxelib name="tjson"/>
	<haxelib name="smidr"/> <!-- SmiðrUI, the engine UI toolkit (editors, options, converters) -->

	<!-- Psych features -->
	<haxelib name="hxluajit"         if="LUA_ALLOWED"/>
	<haxelib name="hxluajit-wrapper" if="LUA_ALLOWED"/>
	<haxelib name="hscript-insanity" if="HSCRIPT_ALLOWED"/>
	<haxelib name="hxvlc"            if="VIDEOS_ALLOWED"/>
	<haxelib name="hxdiscord_rpc"    if="DISCORD_ALLOWED"/>
	<haxelib name="hxhardware"       if="HARDWARE_ALLOWED"/> <!-- haxelib git hxhardware https://github.com/Vortex2Oblivion/hxhardware -->

	<!-- Android: storage paths / permissions / toasts + haptics. Pulls in their
	     bundled android config (Java extension, gradle deps) automatically. -->
	<haxelib name="extension-androidtools" if="android"/>
	<haxelib name="extension-haptics"      if="android"/>

	<haxelib name="hxcpp-debug-server" if="debug"/> <!-- Terminal log prompt on debug builds -->

	<!-- ============================ Haxe Defines =============================== -->

	<!-- Third-party library tuning -->
	<haxedef name="DISCORD_DISABLE_IO_THREAD" if="hxdiscord_rpc" />
	<haxedef name="HXC_LIBVLC_LOGGING"        if="VIDEOS_ALLOWED debug" />
	<haxedef name="HXVLC_NO_SHARE_DIRECTORY"  if="VIDEOS_ALLOWED" />
	<haxedef name="HXC_DEBUG_TRACE"           if="debug" /> <!-- hxCodec debug traces -->

	<!-- Toolchain -->
	<haxedef name="NO_PRECOMPILED_HEADERS" if="linux" />
	<haxedef name="HXCPP_CLANG_CL" if="windows clang" />          <!-- clang-cl + lld (setup/hxcpp-clang-cl.xml): lime build windows -Dclang -->
	<haxedef name="HXCPP_CFLAGS" value="-Wno-all -w" if="android" /> <!-- Silence NDK warning flood from C++ externs -->

	<!-- Crash handler (Izzy Engine) -->
	<haxedef name="HXCPP_CHECK_POINTER" if="CRASH_HANDLER" />
	<haxedef name="HXCPP_STACK_LINE"    if="CRASH_HANDLER" />
	<haxedef name="HXCPP_STACK_TRACE"   if="CRASH_HANDLER" />

	<!-- Flixel core -->
	<haxedef name="FLX_NO_FOCUS_LOST_SCREEN" />
	<haxedef name="FLX_NO_DEBUG" unless="debug" />       <!-- auto-set in release -->
	<haxedef name="NAPE_RELEASE_BUILD" unless="debug" /> <!-- big perf win for Nape release builds -->

	<!-- Misc -->
	<haxedef name="no-deprecation-warnings" />
	<haxedef name="message.reporting" value="pretty" /> <!-- Haxe 4.3.0+: pretty | indent | classic -->

	<!-- Optional HaxeFlixel toggles - uncomment to enable. Careful with the input
	     ones: you'll get null errors if the game uses an API you disable. -->
	<!-- <haxedef name="FLX_RECORD" /> -->              <!-- Flixel recording system -->
	<!-- <haxedef name="FLX_NO_MOUSE_ADVANCED" /> -->   <!-- disable right/middle mouse buttons -->
	<!-- <haxedef name="FLX_NO_NATIVE_CURSOR" /> -->    <!-- disable native cursor (Flash) -->
	<!-- <haxedef name="FLX_NO_MOUSE" if="mobile" /> -->
	<!-- <haxedef name="FLX_NO_KEYBOARD" if="mobile" /> -->
	<!-- <haxedef name="FLX_NO_TOUCH" if="desktop" /> -->
	<!-- <haxedef name="FLX_NO_GAMEPAD" /> -->
	<!-- <haxedef name="FLX_NO_SOUND_TRAY" /> -->
	<!-- <haxedef name="FLX_NO_SOUND_SYSTEM" /> -->

	<!-- =============================== Macros ================================== -->

	<haxeflag name="--macro" value="allowPackage('flash')" />
	<haxeflag name="--macro" value="include('my.pack')" />

	<!-- Android: rewrite File.getContent/getBytes + FileSystem.exists across the game's
	     packages to fall back to APK-bundled assets. No-op on every other target. -->
	<haxeflag name="--macro" value="macros.FileAccessMacro.use()" if="android" />

	<!-- Generates scripting.bridges.* so mod scripts can write `class X extends FlxSprite`,
	     `extends PlayState`, etc. The extendable base list lives in the macro. -->
	<haxeflag name="--macro" value="macros.ScriptedBridgeMacro.generate()" if="HSCRIPT_ALLOWED" />
	<haxeflag name="--macro" value="macros.ScriptedAbstractMacro.generate()" if="HSCRIPT_ALLOWED" />

	<!-- The osu! storyboard runtime is import()-only; psychlua.LuaProxy._importAnchors is what forces it
	     into the build. A `--macro keep()` used to sit here, but keep() ONLY adds @:keep metadata -- it
	     never compiles an unreferenced module, so it did nothing (and the class already has @:keep). -->

	<!-- PsychUI stays compiled for Lua/HScript mods even though the engine's own menus moved to
	     SmidrUI: legacy/editors still references it, but keep() guards against DCE stripping any
	     class a script constructs via import()/reflection. -->
	<haxeflag name="--macro" value="keep('backend.ui')" />

	<!-- Scripts can construct ANY Flixel / flixel-addons class by name (import()/reflection), but DCE
	     only keeps types the engine itself references, so an unreferenced one (e.g.
	     flixel.addons.effects.FlxSkewedSprite) resolves to nil in a script. keep() does not help: it
	     only tags already-compiled types, it does not pull an unreferenced module into the build.
	     include() force-compiles AND keeps every module, and one recursive include covers flixel core
	     AND flixel-addons (both live under the `flixel` package namespace across all classpaths). The
	     ignore list skips modules that can't be compiled as runtime code: the addon integrations
	     needing libraries we don't ship (nape physics, spine editor), the FlxRayCastTilemap deprecation
	     stub (removed in flixel-addons 5.9.0), and flixel's macro-only classes (they use
	     haxe.macro.Context and are meaningless at runtime). -->
	<haxeflag name="--macro" value="include('flixel', true, ['flixel.addons.nape', 'flixel.addons.editors.spine', 'flixel.addons.tile.FlxRayCastTilemap', 'flixel.system.macros'])" />

	<!-- ================================ Icons ================================== -->

	<assets path='art/icons/iconOG.png' rename='icon.png' if="linux || mac" />
	<icon path="art/icons/icon16.png" size='16'/>
	<icon path="art/icons/icon32.png" size='32'/>
	<icon path="art/icons/icon64.png" size='64'/>
	<icon path="art/icons/iconOG.png" />

</project>
